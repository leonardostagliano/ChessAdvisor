{
  "name": "chessadvisor",
  "version": "0.2.6",
  "description": "Learn chess by playing OpenAI models through your Codex session",
  "license": "GPL-3.0-only",
  "main": "./out/main/index.js",
  "author": "Leonardo Stagliano",
  "codexCli": {
    "testedVersion": "0.154.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "codex:types": "codex app-server generate-ts -o src/main/codex/protocol",
    "fetch:stockfish": "node scripts/fetch-stockfish.mjs",
    "build:datasets": "node scripts/build-datasets.mjs",
    "rapid:collect": "node scripts/collect-rapid-games.mjs",
    "rapid:analyze": "node --experimental-strip-types scripts/analyze-rapid-games.mjs",
    "rapid:benchmark": "node scripts/benchmark-rapid-policy.mjs",
    "gen-icon": "node scripts/gen-icon.mjs",
    "build:win": "electron-vite build && electron-builder --win nsis portable --x64 --publish never --config electron-builder.yml",
    "smoke:win": "node scripts/smoke-windows.cjs",
    "e2e": "node test/e2e/play.e2e.mjs",
    "e2e:real": "node test/e2e/play.e2e.mjs --real"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lichess-org/chessground": "^10.1.1",
    "chess.js": "^1.4.0",
    "i18next": "^25.10.10",
    "react-i18next": "^15.7.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fzstd": "^0.1.1",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.63.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^3.2.7"
  }
}
